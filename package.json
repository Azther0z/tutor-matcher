{
  "name": "tutor-matcher",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Matchmaking platform connecting tutors and students by subject, schedule, and price.",
  "scripts": {
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yaml,yml,html}\" \"docs/**/*.{md,yaml,yml,html}\" \"deploy/**/*.{md,yaml,yml,json}\" \".github/**/*.{md,yaml,yml,json}\" \"scripts/**/*.{mjs,cjs,js,html}\" \"README.md\" \"package.json\" \".doco-cd.yaml\" \".prettierrc\" \".sops.yaml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,yaml,yml,html}\" \"docs/**/*.{md,yaml,yml,html}\" \"deploy/**/*.{md,yaml,yml,json}\" \".github/**/*.{md,yaml,yml,json}\" \"scripts/**/*.{mjs,cjs,js,html}\" \"README.md\" \"package.json\" \".doco-cd.yaml\" \".prettierrc\" \".sops.yaml\"",
    "backlog:build": "npm run backlog:validate && node scripts/generate-backlog.mjs",
    "backlog:validate": "node scripts/validate-backlog.mjs",
    "backlog:check": "npm run backlog:validate && node scripts/generate-backlog.mjs --check",
    "prepare": "husky",
    "install:all": "npm install && cd apps/backend && npm install && cd ../frontend && npm install",
    "setup:env": "node scripts/setup-env.mjs",
    "setup": "npm run install:all && npm run setup:env && npm --prefix apps/backend run db:migrate:dev && npm --prefix apps/backend run gen-mock-data",
    "dev": "concurrently --kill-others --names backend,frontend --prefix-colors blue,green \"npm --prefix apps/backend run dev\" \"npm --prefix apps/frontend run dev\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azther0z/tutor-matcher.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Azther0z/tutor-matcher/issues"
  },
  "homepage": "https://github.com/Azther0z/tutor-matcher#readme",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "apps/backend/**/*.ts": [
      "prettier --write",
      "npm --prefix apps/backend run lint -- --fix"
    ],
    "apps/frontend/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "npm --prefix apps/frontend run lint -- --fix"
    ],
    "apps/**/*.{mjs,cjs,json,css,md,yaml,yml,html}": "prettier --write",
    "docs/**/*.{md,yaml,yml,html}": "prettier --write",
    "deploy/**/*.{md,yaml,yml,json}": "prettier --write",
    ".github/**/*.{md,yaml,yml,json}": "prettier --write",
    "scripts/**/*.{mjs,cjs,js,html}": "prettier --write",
    "*.{js,mjs,cjs,json,md,yaml,yml}": "prettier --write",
    ".doco-cd.yaml": "prettier --write",
    ".prettierrc": "prettier --write",
    ".sops.yaml": "prettier --write"
  }
}
