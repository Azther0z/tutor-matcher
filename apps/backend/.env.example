DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutor_matcher"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:3000"

# Development and tests log reset links by default. Set to "resend" only when
# you intentionally want to send a real email from the host development flow.
EMAIL_DELIVERY_MODE="log"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Tutor Matcher <onboarding@resend.dev>"
