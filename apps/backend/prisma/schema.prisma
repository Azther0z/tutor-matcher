generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum WalletTransactionType {
  TOP_UP
  LESSON_PAYMENT
  LESSON_EARNING
  REFUND
  PAYOUT
}

enum TutorStatus {
  UNPUBLISHED
  PUBLISHED
}

enum TutorProfileVersionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SubjectFormat {
  ONLINE
}

enum StudentEducationLevel {
  PRIMARY_SCHOOL
  LOWER_SECONDARY_SCHOOL
  UPPER_SECONDARY_SCHOOL
  VOCATIONAL_CERTIFICATE
  HIGHER_VOCATIONAL_CERTIFICATE
  UNIVERSITY
  WORKING_ADULT
}

enum PreferredLearningPeriod {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

model User {
  id        String   @id @default(uuid()) @map("user_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isAdmin   Boolean  @default(false) @map("is_admin")

  notifyOnBooking Boolean @default(true) @map("notify_on_booking")
  notifyOnMessage Boolean @default(true) @map("notify_on_message")
  notifyOnPayment Boolean @default(true) @map("notify_on_payment")

  // A user account can optionally be linked to a tutor profile
  tutorId String? @unique @map("tutor_id") @db.Uuid
  tutor   Tutor?  @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  student                 Student?
  profileVersions         TutorProfileVersion[] @relation("ProfileVersionOwner")
  reviewedProfileVersions TutorProfileVersion[] @relation("ProfileVersionReviewer")

  bookings Booking[]
  reviews  Review[]

  passwordResetTokens PasswordResetToken[]

  sentMessages     Message[] @relation("MessagesSent")
  receivedMessages Message[] @relation("MessagesReceived")

  walletTransactions WalletTransaction[]

  reportsFiledAsAdmin Report[] @relation("ReportsHandledByAdmin")
  reportsMade         Report[] @relation("ReportsMadeByReporter")
  reportsReceived     Report[] @relation("ReportsAgainstUser")

  @@map("users")
}

model Student {
  id                       String                  @id @default(uuid()) @map("student_id") @db.Uuid
  userId                   String                  @unique @map("user_id") @db.Uuid
  educationLevel           StudentEducationLevel   @map("education_level")
  goals                    String[]
  preferredLearningPeriod  PreferredLearningPeriod @map("preferred_learning_period")
  preferredDurationMinutes Int                     @map("preferred_duration_minutes")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningAreas StudentLearningArea[]

  @@map("students")
}

model LearningArea {
  id       String                @id @default(uuid()) @map("learning_area_id") @db.Uuid
  name     String                @unique
  students StudentLearningArea[]

  @@map("learning_areas")
}

model StudentLearningArea {
  studentId      String       @map("student_id") @db.Uuid
  learningAreaId String       @map("learning_area_id") @db.Uuid
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  learningArea   LearningArea @relation(fields: [learningAreaId], references: [id], onDelete: Restrict)

  @@id([studentId, learningAreaId])
  @@map("student_learning_areas")
}

model Tutor {
  id                      String      @id @default(uuid()) @map("tutor_id") @db.Uuid
  currentProfileVersionId String      @unique @map("current_profile_version_id") @db.Uuid
  enrolledAt              DateTime    @default(now()) @map("enrolled_at")
  status                  TutorStatus @default(UNPUBLISHED)

  currentProfileVersion TutorProfileVersion @relation(fields: [currentProfileVersionId], references: [id], onDelete: Restrict)
  user                  User?
  subjects              Subject[]
  availabilities        Availability[]

  @@map("tutors")
}

model TutorProfileVersion {
  id                    String                    @id @default(uuid()) @map("profile_version_id") @db.Uuid
  userId                String                    @map("user_id") @db.Uuid
  avatarUrl             String?                   @map("avatar_url")
  bio                   String?
  introVideoUrl         String?                   @map("intro_video_url")
  identificationCardUrl String?                   @map("identification_card_url")
  status                TutorProfileVersionStatus @default(DRAFT)
  createdAt             DateTime                  @default(now()) @map("created_at")
  submittedAt           DateTime?                 @map("submitted_at")
  reviewedAt            DateTime?                 @map("reviewed_at")
  reviewedById          String?                   @map("reviewed_by_id") @db.Uuid
  rejectionReason       String?                   @map("rejection_reason")

  user            User                               @relation("ProfileVersionOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy      User?                              @relation("ProfileVersionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  currentForTutor Tutor?
  certifications  TutorProfileVersionCertification[]

  @@unique([userId], map: "tutor_profile_versions_one_pending_per_user", where: { status: "PENDING" })
  @@index([userId, createdAt])
  @@index([status, submittedAt])
  @@map("tutor_profile_versions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @map("password_reset_token_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Subject {
  id          String        @id @default(uuid()) @map("subject_id") @db.Uuid
  name        String
  description String?
  videoUrl    String?       @map("video_url")
  hourlyRate  Decimal       @map("hourly_rate") @db.Decimal(10, 2)
  format      SubjectFormat @default(ONLINE)

  tutorId String @map("tutor_id") @db.Uuid
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  availabilitySubjects AvailabilitySubject[]
  bookings             Booking[]
  reviews              Review[]

  @@index([tutorId])
  @@map("subjects")
}

model Availability {
  id        String   @id @default(uuid()) @map("availability_id") @db.Uuid
  startedAt DateTime @map("started_at")
  isOpen    Boolean  @default(true) @map("is_open")
  tutorId   String   @map("tutor_id") @db.Uuid
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  bookingId String?  @map("booking_id") @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  availabilitySubjects AvailabilitySubject[]

  @@unique([tutorId, startedAt])
  @@index([bookingId])
  @@map("availabilities")
}

model AvailabilitySubject {
  availabilityId String       @map("availability_id") @db.Uuid
  subjectId      String       @map("subject_id") @db.Uuid
  availability   Availability @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([availabilityId, subjectId])
  @@map("availability_subjects")
}

model Booking {
  id                 String        @id @default(uuid()) @map("booking_id") @db.Uuid
  description        String?
  zoomMeetingUrl     String?       @map("zoom_meeting_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  status             BookingStatus @default(PENDING_PAYMENT)
  isTrial            Boolean       @default(true) @map("is_trial")
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  startedAt          DateTime      @map("started_at")
  endedAt            DateTime      @map("ended_at")
  paymentExpiresAt   DateTime?     @map("payment_expires_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  cancellationReason String?       @map("cancellation_reason")

  // Legacy bookings are captured before their subject's first edit.
  subjectName        String?        @map("subject_name")
  subjectDescription String?        @map("subject_description")
  subjectHourlyRate  Decimal?       @map("subject_hourly_rate") @db.Decimal(10, 2)
  subjectFormat      SubjectFormat? @map("subject_format")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  availabilities     Availability[]
  walletTransactions WalletTransaction[]
  reviews            Review[]

  @@index([userId])
  @@index([subjectId])
  @@index([userId, status])
  @@index([status, paymentExpiresAt])
  @@map("bookings")
}

model WalletTransaction {
  id           String                @id @default(uuid()) @map("wallet_transaction_id") @db.Uuid
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(12, 2)
  balanceAfter Decimal               @map("balance_after") @db.Decimal(12, 2)
  createdAt    DateTime              @default(now()) @map("created_at")
  userId       String                @map("user_id") @db.Uuid
  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookingId    String?               @map("booking_id") @db.Uuid
  booking      Booking?              @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([bookingId, type])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model Review {
  id          String   @id @default(uuid()) @map("review_id") @db.Uuid
  ratingStars Int      @map("rating_stars")
  text        String?
  createdAt   DateTime @default(now()) @map("created_at")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  bookingId String  @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([subjectId])
  @@index([bookingId])
  @@map("reviews")
}

model TutorProfileVersionCertification {
  id               String              @id @default(uuid()) @map("certification_id") @db.Uuid
  fileUrl          String              @map("file_url")
  profileVersionId String              @map("profile_version_id") @db.Uuid
  profileVersion   TutorProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Cascade)

  @@index([profileVersionId])
  @@map("tutor_profile_version_certifications")
}

model Message {
  id        String   @id @default(uuid()) @map("message_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  message   String

  fromUserId String @map("from_user_id") @db.Uuid
  fromUser   User   @relation("MessagesSent", fields: [fromUserId], references: [id], onDelete: Restrict)

  toUserId String @map("to_user_id") @db.Uuid
  toUser   User   @relation("MessagesReceived", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([fromUserId])
  @@index([toUserId])
  @@map("messages")
}

model Report {
  id           String  @id @default(uuid()) @map("report_id") @db.Uuid
  message      String
  attachment   String?
  replyMessage String? @map("reply_message")

  adminUserId String @map("admin_user_id") @db.Uuid
  adminUser   User   @relation("ReportsHandledByAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)

  reporterUserId String @map("reporter_user_id") @db.Uuid
  reporterUser   User   @relation("ReportsMadeByReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)

  reportedUserId String @map("reported_user_id") @db.Uuid
  reportedUser   User   @relation("ReportsAgainstUser", fields: [reportedUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId])
  @@index([reporterUserId])
  @@index([reportedUserId])
  @@map("reports")
}
