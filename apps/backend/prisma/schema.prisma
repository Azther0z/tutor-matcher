generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentType {
  REFUND
  PAYOUT
  TRANSFER
}

enum PaymentStatus {
  PENDING
  HOLDING
  COMPLETED
  CANCELLED
}

enum TutorStatus {
  PENDING
  UNPUBLISHED
  PUBLISHED
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum StudentEducationLevel {
  PRIMARY_SCHOOL
  LOWER_SECONDARY_SCHOOL
  UPPER_SECONDARY_SCHOOL
  VOCATIONAL_CERTIFICATE
  HIGHER_VOCATIONAL_CERTIFICATE
  UNIVERSITY
  WORKING_ADULT
}

enum PreferredLearningPeriod {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

model User {
  id        String   @id @default(uuid()) @map("user_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isAdmin   Boolean  @default(false) @map("is_admin")

  // A user account can optionally be linked to a tutor profile
  tutorId String? @unique @map("tutor_id") @db.Uuid
  tutor   Tutor?  @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  student Student?

  bookings          Booking[] @relation("BookingStudent")
  bookingsCancelled Booking[] @relation("BookingCancelledBy")
  reviews           Review[]

  sentMessages     Message[] @relation("MessagesSent")
  receivedMessages Message[] @relation("MessagesReceived")

  paymentsSent     Payment[] @relation("PaymentsFrom")
  paymentsReceived Payment[] @relation("PaymentsTo")

  reportsFiledAsAdmin Report[] @relation("ReportsHandledByAdmin")
  reportsMade         Report[] @relation("ReportsMadeByReporter")
  reportsReceived     Report[] @relation("ReportsAgainstUser")

  @@map("users")
}

model Student {
  id                       String                  @id @default(uuid()) @map("student_id") @db.Uuid
  userId                   String                  @unique @map("user_id") @db.Uuid
  educationLevel           StudentEducationLevel   @map("education_level")
  goals                    String[]
  preferredLearningPeriod  PreferredLearningPeriod @map("preferred_learning_period")
  preferredDurationMinutes Int                     @map("preferred_duration_minutes")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningAreas StudentLearningArea[]

  @@map("students")
}

model LearningArea {
  id       String                @id @default(uuid()) @map("learning_area_id") @db.Uuid
  name     String                @unique
  students StudentLearningArea[]

  @@map("learning_areas")
}

model StudentLearningArea {
  studentId      String       @map("student_id") @db.Uuid
  learningAreaId String       @map("learning_area_id") @db.Uuid
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  learningArea   LearningArea @relation(fields: [learningAreaId], references: [id], onDelete: Restrict)

  @@id([studentId, learningAreaId])
  @@map("student_learning_areas")
}

model Tutor {
  id            String      @id @default(uuid()) @map("tutor_id") @db.Uuid
  avatarUrl     String?     @map("avatar_url")
  bio           String?
  introVideoUrl String?     @map("intro_video_url")
  governmentId  String      @map("government_id")
  enrolledAt    DateTime    @default(now()) @map("enrolled_at")
  status        TutorStatus @default(PENDING)

  user           User?
  subjects       Subject[]
  certifications Certification[]

  @@map("tutors")
}

model Subject {
  id          String  @id @default(uuid()) @map("subject_id") @db.Uuid
  name        String
  description String?
  videoUrl    String? @map("video_url")
  hourlyRate  Decimal @map("hourly_rate") @db.Decimal(10, 2)

  tutorId String @map("tutor_id") @db.Uuid
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  availabilitySubjects AvailabilitySubject[]
  bookings             Booking[]
  reviews              Review[]

  @@index([tutorId])
  @@map("subjects")
}

model Availability {
  id        String   @id @default(uuid()) @map("availability_id") @db.Uuid
  startedAt DateTime @map("started_at")

  bookingId String?  @map("booking_id") @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  availabilitySubjects AvailabilitySubject[]

  @@index([bookingId])
  @@map("availabilities")
}

model AvailabilitySubject {
  availabilityId String       @map("availability_id") @db.Uuid
  subjectId      String       @map("subject_id") @db.Uuid
  availability   Availability @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([availabilityId, subjectId])
  @@map("availability_subjects")
}

model Booking {
  id                 String        @id @default(uuid()) @map("booking_id") @db.Uuid
  description        String?
  zoomMeetingUrl     String?       @map("zoom_meeting_url")
  createdAt          DateTime      @default(now()) @map("created_at")
  status             BookingStatus @default(PENDING_PAYMENT)
  isTrial            Boolean       @default(true) @map("is_trial")
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  startedAt          DateTime      @map("started_at")
  endedAt            DateTime      @map("ended_at")
  paymentExpiresAt   DateTime?     @map("payment_expires_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  cancellationReason String?       @map("cancellation_reason")

  userId String @map("user_id") @db.Uuid
  user   User   @relation("BookingStudent", fields: [userId], references: [id], onDelete: Restrict)

  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  // BOOK-4: who cancelled the lesson — the student or the tutor — for refund routing and reliability tracking.
  cancelledByUserId String? @map("cancelled_by_user_id") @db.Uuid
  cancelledBy       User?   @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  availabilities Availability[]
  payments       Payment[]
  reviews        Review[]

  @@index([userId])
  @@index([subjectId])
  @@index([userId, status])
  @@index([status, paymentExpiresAt])
  @@index([cancelledByUserId])
  @@map("bookings")
}

model Payment {
  id          String        @id @default(uuid()) @map("payment_id") @db.Uuid
  type        PaymentType
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  completedAt DateTime?     @map("completed_at")

  // A null party represents the platform side of escrow, refunds, fees, and future top-ups.
  fromUserId String? @map("from_user_id") @db.Uuid
  fromUser   User?   @relation("PaymentsFrom", fields: [fromUserId], references: [id], onDelete: Restrict)

  toUserId String? @map("to_user_id") @db.Uuid
  toUser   User?   @relation("PaymentsTo", fields: [toUserId], references: [id], onDelete: Restrict)

  bookingId String?  @map("booking_id") @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([bookingId])
  @@map("payments")
}

model Review {
  id          String   @id @default(uuid()) @map("review_id") @db.Uuid
  ratingStars Int      @map("rating_stars")
  text        String?
  createdAt   DateTime @default(now()) @map("created_at")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  bookingId String  @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([subjectId])
  @@index([bookingId])
  @@map("reviews")
}

model Certification {
  id      String @id @default(uuid()) @map("certification_id") @db.Uuid
  fileUrl String @map("file_url")

  tutorId String @map("tutor_id") @db.Uuid
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  @@index([tutorId])
  @@map("certifications")
}

model Message {
  id        String   @id @default(uuid()) @map("message_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  message   String

  fromUserId String @map("from_user_id") @db.Uuid
  fromUser   User   @relation("MessagesSent", fields: [fromUserId], references: [id], onDelete: Restrict)

  toUserId String @map("to_user_id") @db.Uuid
  toUser   User   @relation("MessagesReceived", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([fromUserId])
  @@index([toUserId])
  @@map("messages")
}

model Report {
  id           String  @id @default(uuid()) @map("report_id") @db.Uuid
  message      String
  attachment   String?
  replyMessage String? @map("reply_message")

  adminUserId String @map("admin_user_id") @db.Uuid
  adminUser   User   @relation("ReportsHandledByAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)

  reporterUserId String @map("reporter_user_id") @db.Uuid
  reporterUser   User   @relation("ReportsMadeByReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)

  reportedUserId String @map("reported_user_id") @db.Uuid
  reportedUser   User   @relation("ReportsAgainstUser", fields: [reportedUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId])
  @@index([reporterUserId])
  @@index([reportedUserId])
  @@map("reports")
}
