generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model PostalAddress {
  postalCode String   @id @map("PostalCode") @db.VarChar(10)
  province   String   @map("Province") @db.VarChar(50)
  district   String   @map("District") @db.VarChar(50)
  persons    Person[]

  @@map("PostalAddress")
}

model Person {
  personId       Int           @id @default(autoincrement()) @map("PersonID")
  username       String        @unique @map("Username") @db.VarChar(50)
  password       String        @map("Password") @db.VarChar(255)
  preferredName  String?       @map("PreferredName") @db.VarChar(50)
  firstName      String        @map("FirstName") @db.VarChar(50)
  lastName       String        @map("LastName") @db.VarChar(50)
  email          String        @unique @map("Email") @db.VarChar(100)
  phoneNumber    String?       @map("PhoneNumber") @db.VarChar(20)
  profilePicture String?       @map("ProfilePicture") @db.VarChar(255)
  birthDate      DateTime?     @map("BirthDate") @db.Date
  subDistrict    String?       @map("SubDistrict") @db.VarChar(50)
  postalCode     String?       @map("PostalCode") @db.VarChar(10)
  dateJoined     DateTime      @default(now()) @map("DateJoined")
  lastLogin      DateTime?     @map("LastLogin")

  address        PostalAddress? @relation(fields: [postalCode], references: [postalCode])
  tutor          Tutor?
  student        Student?
  admin          Admin?
  reportsFiledBy Report[]      @relation("Reporter")
  reportsAgainst Report[]      @relation("ReportedPerson")

  @@map("Person")
}

model Tutor {
  personId           Int                      @id @map("PersonID")
  bio                String?                  @map("Bio")
  citizenId          String                   @unique @map("CitizenID") @db.VarChar(20)
  verificationStatus String                   @default("Pending") @map("VerificationStatus") @db.VarChar(20)
  yearStartTeaching  Int?                     @map("YearStartTeaching") @db.SmallInt
  preferredGap       Int?                     @map("PreferredGap")

  person             Person                   @relation(fields: [personId], references: [personId], onDelete: Cascade)
  educationHistory   TutorEducationBackground[]
  classes            Class[]
  posts              Post[]

  @@map("Tutor")
}

model TutorEducationBackground {
  educationId      Int    @id @default(autoincrement()) @map("EducationID")
  personId         Int    @map("PersonID")
  institutionName  String @map("InstitutionName") @db.VarChar(100)
  degreeLevel      String @map("DegreeLevel") @db.VarChar(100)
  majorField       String @map("MajorField") @db.VarChar(100)
  graduationYear   Int    @map("GraduationYear")

  tutor            Tutor  @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@map("TutorEducationBackground")
}

model Student {
  personId   Int                        @id @map("PersonID")
  schoolName String?                    @map("SchoolName") @db.VarChar(100)
  gradeLevel String?                    @map("GradeLevel") @db.VarChar(20)

  person     Person                     @relation(fields: [personId], references: [personId], onDelete: Cascade)
  interests  StudentInterestedCategory[]
  bookings   Booking[]
  reviews    Review[]

  @@map("Student")
}

model StudentInterestedCategory {
  personId Int     @map("PersonID")
  category String  @map("Category") @db.VarChar(50)

  student  Student @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@id([personId, category])
  @@map("StudentInterestedCategory")
}

model Admin {
  personId       Int      @id @map("PersonID")
  role           String   @map("Role") @db.VarChar(50)

  person         Person   @relation(fields: [personId], references: [personId], onDelete: Cascade)
  handledReports Report[]

  @@map("Admin")
}

model Class {
  classId      Int             @id @default(autoincrement()) @map("ClassID")
  tutorId      Int             @map("TutorID")
  className    String          @map("ClassName") @db.VarChar(100)
  pricePerHour Decimal         @map("PricePerHour") @db.Decimal(10, 2)
  description  String?         @map("Description")

  tutor        Tutor           @relation(fields: [tutorId], references: [personId])
  categories   ClassCategory[]
  slots        AvailableTime[]
  reviews      Review[]
  posts        Post[]

  @@map("Class")
}

model ClassCategory {
  classId  Int    @map("ClassID")
  category String @map("Category") @db.VarChar(50)

  class    Class  @relation(fields: [classId], references: [classId], onDelete: Cascade)

  @@id([classId, category])
  @@map("ClassCategory")
}

model AvailableTime {
  slotId        Int       @id @default(autoincrement()) @map("SlotID")
  classId       Int       @map("ClassID")
  bookingId     Int?      @map("BookingID")
  availableDate DateTime  @map("AvailableDate") @db.Date
  startTime     DateTime  @map("StartTime") @db.Time
  endTime       DateTime  @map("EndTime") @db.Time
  isAvailable   Boolean   @map("IsAvailable")

  class         Class     @relation(fields: [classId], references: [classId])
  booking       Booking?  @relation(fields: [bookingId], references: [bookingId])

  @@map("AvailableTime")
}

model Booking {
  bookingId        Int             @id @default(autoincrement()) @map("BookingID")
  studentId        Int             @map("StudentID")
  studentMessage   String?         @map("StudentMessage")
  status           String          @default("Pending") @map("Status") @db.VarChar(20)
  bookingTimestamp DateTime        @default(now()) @map("BookingTimestamp")

  student          Student         @relation(fields: [studentId], references: [personId])
  slots            AvailableTime[]
  payment          Payment?
  review           Review[]

  @@map("Booking")
}

model Payment {
  paymentId        Int      @id @default(autoincrement()) @map("PaymentID")
  bookingId        Int      @unique @map("BookingID")
  paymentStatus    String   @default("Pending") @map("PaymentStatus") @db.VarChar(20)
  paymentMethod    String?  @map("PaymentMethod") @db.VarChar(50)
  transactionProof String?  @map("TransactionProof")
  paymentTimestamp DateTime @default(now()) @map("PaymentTimestamp")

  booking          Booking  @relation(fields: [bookingId], references: [bookingId])

  @@map("Payment")
}

model Review {
  reviewId    Int      @id @default(autoincrement()) @map("ReviewID")
  studentId   Int      @map("StudentID")
  classId     Int      @map("ClassID")
  bookingId   Int?     @map("BookingID")
  ratingScore Int      @map("RatingScore") @db.SmallInt
  comment     String?  @map("Comment")
  reviewedAt  DateTime @default(now()) @map("ReviewedAt")

  student     Student  @relation(fields: [studentId], references: [personId])
  class       Class    @relation(fields: [classId], references: [classId])
  booking     Booking? @relation(fields: [bookingId], references: [bookingId])

  @@map("Review")
}

model Report {
  reportId             Int      @id @default(autoincrement()) @map("ReportID")
  reporterId           Int      @map("ReporterID")
  reportedPersonId     Int      @map("ReportedPersonID")
  handlerAdminId       Int?     @map("HandlerAdminID")
  reportType           String   @map("ReportType") @db.VarChar(50)
  reportMessage        String   @map("ReportMessage")
  evidenceImage        String?  @map("EvidenceImage")
  status               String   @default("Open") @map("Status") @db.VarChar(20)
  adminResponseMessage String?  @map("AdminResponseMessage")
  reportTimestamp      DateTime @default(now()) @map("ReportTimestamp")

  reporter             Person   @relation("Reporter", fields: [reporterId], references: [personId])
  reportedPerson       Person   @relation("ReportedPerson", fields: [reportedPersonId], references: [personId])
  handlerAdmin         Admin?   @relation(fields: [handlerAdminId], references: [personId])

  @@map("Report")
}

model Post {
  postId      Int      @id @default(autoincrement()) @map("PostID")
  tutorId     Int      @map("TutorID")
  classId     Int?     @map("ClassID")
  title       String   @map("Title") @db.VarChar(255)
  contentBody String   @map("ContentBody")
  postedAt    DateTime @default(now()) @map("PostedAt")
  viewCount   Int      @default(0) @map("ViewCount")

  tutor       Tutor    @relation(fields: [tutorId], references: [personId])
  class       Class?   @relation(fields: [classId], references: [classId])

  @@map("Post")
}
