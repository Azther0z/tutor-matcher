generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentType {
  REFUND
  PAYOUT
  TRANSFER
}

enum PaymentStatus {
  PENDING
  HOLDING
  COMPLETED
  CANCELLED
}

enum TutorStatus {
  PENDING
  UNPUBLISHED
  PUBLISHED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement()) @map("user_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String
  bio       String?
  createdAt DateTime @default(now()) @map("created_at")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  isAdmin   Boolean  @default(false) @map("is_admin")
  isTutor   Boolean  @default(false) @map("is_tutor")

  // A user account can optionally be linked to a tutor profile
  tutorId Int?   @unique @map("tutor_id")
  tutor   Tutor? @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  studentProfile StudentProfile?

  bookings Booking[]
  reviews  Review[]

  sentMessages     Message[] @relation("MessagesSent")
  receivedMessages Message[] @relation("MessagesReceived")

  paymentsSent     Payment[] @relation("PaymentsFrom")
  paymentsReceived Payment[] @relation("PaymentsTo")

  reportsFiledAsAdmin Report[] @relation("ReportsHandledByAdmin")
  reportsMade         Report[] @relation("ReportsMadeByReporter")
  reportsReceived     Report[] @relation("ReportsAgainstUser")

  @@map("users")
}

model Tutor {
  id            Int         @id @default(autoincrement()) @map("tutor_id")
  avatarUrl     String?     @map("avatar_url")
  bio           String?
  introVideoUrl String?     @map("intro_video_url")
  governmentId  String      @map("government_id")
  enrolledAt    DateTime    @default(now()) @map("enrolled_at")
  status        TutorStatus @default(PENDING)

  user           User?
  subjects       Subject[]
  certifications Certification[]

  @@map("tutors")
}

model StudentProfile {
  id                   Int      @id @default(autoincrement()) @map("student_profile_id")
  userId               Int      @unique @map("user_id")
  level                String
  goals                String
  preferredWeekdays    Int[]    @default([]) @map("preferred_weekdays")
  preferredStartMinute Int?     @map("preferred_start_minute")
  preferredEndMinute   Int?     @map("preferred_end_minute")
  timezone             String   @default("UTC")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects StudentProfileSubject[]

  @@map("student_profiles")
}

model StudentProfileSubject {
  id        Int    @id @default(autoincrement()) @map("student_profile_subject_id")
  profileId Int    @map("profile_id")
  name      String

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([name])
  @@map("student_profile_subjects")
}

model Subject {
  id          Int     @id @default(autoincrement()) @map("subject_id")
  name        String
  description String?
  videoUrl    String? @map("video_url")
  hourlyRate  Decimal @map("hourly_rate") @db.Decimal(10, 2)

  tutorId Int   @map("tutor_id")
  tutor   Tutor @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  availabilitySubjects AvailabilitySubject[]
  bookings             Booking[]
  reviews              Review[]

  @@index([tutorId])
  @@map("subjects")
}

model Availability {
  id        Int      @id @default(autoincrement()) @map("availability_id")
  startedAt DateTime @map("started_at")

  bookingId Int?     @unique @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  availabilitySubjects AvailabilitySubject[]

  @@map("availabilities")
}

model AvailabilitySubject {
  availabilityId Int          @map("availability_id")
  subjectId      Int          @map("subject_id")
  availability   Availability @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([availabilityId, subjectId])
  @@map("availability_subjects")
}

model Booking {
  id             Int      @id @default(autoincrement()) @map("booking_id")
  description    String?
  zoomMeetingUrl String   @map("zoom_meeting_url")
  createdAt      DateTime @default(now()) @map("created_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  subjectId Int     @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  availability Availability?
  payment      Payment?
  reviews      Review[]

  @@index([userId])
  @@index([subjectId])
  @@map("bookings")
}

model Payment {
  id          Int           @id @default(autoincrement()) @map("payment_id")
  type        PaymentType
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  completedAt DateTime?     @map("completed_at")

  fromUserId Int  @map("from_user_id")
  fromUser   User @relation("PaymentsFrom", fields: [fromUserId], references: [id], onDelete: Restrict)

  toUserId Int  @map("to_user_id")
  toUser   User @relation("PaymentsTo", fields: [toUserId], references: [id], onDelete: Restrict)

  bookingId Int?     @unique @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([fromUserId])
  @@index([toUserId])
  @@map("payments")
}

model Review {
  id          Int      @id @default(autoincrement()) @map("review_id")
  ratingStars Int      @map("rating_stars")
  text        String?
  createdAt   DateTime @default(now()) @map("created_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  subjectId Int     @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  bookingId Int     @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([subjectId])
  @@index([bookingId])
  @@map("reviews")
}

model Certification {
  id      Int    @id @default(autoincrement()) @map("certification_id")
  fileUrl String @map("file_url")

  tutorId Int   @map("tutor_id")
  tutor   Tutor @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  @@index([tutorId])
  @@map("certifications")
}

model Message {
  id        Int      @id @default(autoincrement()) @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")
  message   String

  fromUserId Int  @map("from_user_id")
  fromUser   User @relation("MessagesSent", fields: [fromUserId], references: [id], onDelete: Restrict)

  toUserId Int  @map("to_user_id")
  toUser   User @relation("MessagesReceived", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([fromUserId])
  @@index([toUserId])
  @@map("messages")
}

model Report {
  id           Int     @id @default(autoincrement()) @map("report_id")
  message      String
  attachment   String?
  replyMessage String? @map("reply_message")

  adminUserId Int  @map("admin_user_id")
  adminUser   User @relation("ReportsHandledByAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)

  reporterUserId Int  @map("reporter_user_id")
  reporterUser   User @relation("ReportsMadeByReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)

  reportedUserId Int  @map("reported_user_id")
  reportedUser   User @relation("ReportsAgainstUser", fields: [reportedUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId])
  @@index([reporterUserId])
  @@index([reportedUserId])
  @@map("reports")
}
