{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,

    "types": ["node"]
  },
  "include": ["src", "prisma", "prisma.config.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
